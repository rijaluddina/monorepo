# ── API Environment Variables ──────────────────────────────────────────
# Copy this file to .env (root) or provide these variables explicitly:
#
#   cp .env.example ../../.env
#
# For local development, use localhost for all services.

# ── Required ───────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Example (local): postgresql://postgres:postgres@localhost:5432/monorepo_db
# Example (Docker): postgresql://postgres:postgres@postgres:5432/monorepo_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monorepo_db"

# ── Optional — sensible defaults ──────────────────────────────────────

# Application port
# Default: 3000
# PORT=3000

# Environment
# Accepted: development, production, test
# Default: development
# NODE_ENV=development

# Redis connection string
# Format: redis://[:password@]host:port
# Default: redis://localhost:6379
# REDIS_URL="redis://localhost:6379"

# CORS allowed origin(s)
# Supports:
#   - Not set         → regex /^https?:\/\/localhost:\d{4,5}$/ (local dev)
#   - Single origin   → https://app.example.com
#   - Multiple        → http://localhost:5173,https://app.example.com
#   - Regex (^ prefix) → ^https?:\/\/.+\.myapp\.com$
# CORS_ORIGIN=http://localhost:5173

# Outbox processor polling interval in milliseconds
# Default: 5000
# OUTBOX_INTERVAL=5000

# Pino log level
# Accepted: trace, debug, info, warn, error, fatal
# Default: info
# LOG_LEVEL=info
