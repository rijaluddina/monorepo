{
  "type": "module",
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "clean": "rm -rf dist",
    "db:generate": "cd ../../packages/infrastructure && bun run db:generate",
    "db:migrate": "cd ../../packages/infrastructure && bun run db:migrate",
    "db:seed": "cd ../../packages/infrastructure && bun run db:seed"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.0",
    "@repo/application": "*",
    "@repo/infrastructure": "*",
    "@repo/shared": "*",
    "elysia": "^1.3.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "bun-types": "^1.3.13",
    "typescript": "^5.7.0"
  }
}
