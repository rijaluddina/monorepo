{
  "type": "module",
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test --env-file=../../.env",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "clean": "rm -rf dist",
    "db:generate": "cd ../../packages/infrastructure && bun run db:generate",
    "db:migrate": "cd ../../packages/infrastructure && bun run db:migrate",
    "db:seed": "cd ../../packages/infrastructure && bun run db:seed"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.0",
    "@repo/application": "*",
    "@repo/config": "*",
    "@repo/infrastructure": "*",
    "@repo/shared": "*",
    "drizzle-orm": "^0.38.0",
    "elysia": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.13",
    "ioredis": "^5.10.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "typescript": "^5.7.0"
  }
}
