# ── Production Environment (copy to .env.production) ──────────────────────
# cp .env.example .env.production
#
# Gunakan Docker service names sebagai hostname (postgres, redis) —
# bukan localhost atau IP host. Di dalam Docker network, service names
# di-resolve oleh embedded DNS Docker (127.0.0.11).
#
# ⚠️ Pastikan password cocok dengan default di docker-compose.yml:
#    POSTGRES_PASSWORD=postgres, REDIS_PASSWORD=superadmin

# ── PostgreSQL ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/monorepo_db"

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────
# Origin dari browser di production (nginx port 80, bukan Vite dev)
# Examples:
#   Single origin  → CORS_ORIGIN="https://app.example.com"
#   Multiple       → CORS_ORIGIN="https://app.example.com,https://admin.example.com"
#   Regex          → CORS_ORIGIN="^https?:\/\/(.+\\.)?myapp\\.com$"
CORS_ORIGIN=http://localhost

# ── Redis ─────────────────────────────────────────────────────────────────
# Format: redis://[:password@]host:port
REDIS_URL="redis://:superadmin@redis:6379"
