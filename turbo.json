{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "CORS_ORIGIN",
    "PORT",
    "LOG_LEVEL",
    "OUTBOX_INTERVAL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "clean": {
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:generate": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
